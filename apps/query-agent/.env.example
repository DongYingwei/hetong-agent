# jinguan-qa 查询侧配置模板 —— 可入 git。
# 复制为 .env 并填入真实值（.env 已被 .gitignore 挡住，勿提交真实密钥）。
#
# 查询侧是【只读消费】：SQL 走 PG 只读角色，向量走 embedding/Milvus/reranker，
# LLM 走 DeepSeek（CoreMind ReAct 用）。端点默认值已写死在代码里，这里覆盖即可。

# ── PostgreSQL 只读连接（G1，三道只读防线第③道）──
# 必须是【只读角色】连接串，不是解析侧的写库账号。sql_query.ts 读此变量。
PG_READONLY_URL=postgresql://<readonly-user>:<pass>@<host>:5432/contracts

# ── LLM（DeepSeek）——CoreMind ReAct 路由/生成用 ──
# coremind.yaml 的 provider.apiKeyEnv 指向此变量名；跑真对话/eval 必需。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 向量：embedding / reranker（缺省已指向 .33，改这里可覆盖）──
EMBED_BASE_URL=http://192.168.121.33:8008
EMBED_MODEL=Qwen3-Embedding-4B
RERANK_BASE_URL=http://192.168.121.33:8012
RERANK_MODEL=Qwen3-Reranker-8B

# ── Milvus ──
MILVUS_URI=http://localhost:19530
