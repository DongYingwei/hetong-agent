# jinguan-parse 解析侧端点配置模板 —— 可入 git。
# 复制为 .env 并填入真实值（.env 已被 .gitignore 挡住，勿提交真实密钥）。

# ── MinerU 解析服务 ──
MINERU_BASE_URL=http://<mineru-host>:8000
MINERU_PARSE_PATH=/file_parse
# backend: pipeline(自包含无幻觉) / vlm-http-client(需 server_url=PaddleOCR-VL 地址)
MINERU_BACKEND=vlm-http-client
MINERU_SERVER_URL=http://<paddleocr-vl-host>:18080
MINERU_TIMEOUT_S=300

# ── LLM 主模型（本地 Qwen）——解析侧分组抽取 17 个 AI 字段 ──
# Qwen 先抽取；超时、结构化失败或关键字段不足时，才调用下方 DeepSeek 兜底。
LLM_PRIMARY_BASE_URL=http://192.168.121.32:6013/v1
LLM_PRIMARY_MODEL=Qwen3.8-27B
LLM_PRIMARY_API_KEY=EMPTY

# ── LLM 兜底（DeepSeek）──
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 单次结构化抽取最长等待时间（秒）。内容风控回退到本地 Qwen 时同样生效。
LLM_TIMEOUT_S=180

# ── 向量：embedding / reranker ──
EMBED_BASE_URL=http://<vector-host>:8008
EMBED_MODEL=Qwen3-Embedding-4B
RERANK_BASE_URL=http://<vector-host>:8012
RERANK_MODEL=Qwen3-Reranker-4B

# ── Milvus ──
MILVUS_URI=http://localhost:19530

# ── PostgreSQL（contracts-db）解析侧写库连接 ──
PG_URL=postgresql://<user>:<pass>@<host>:5432/contracts

# ── 合同原件及 Markdown 缓存（生产环境指向持久数据盘，两个目录均由服务账号可写）──
PDF_ROOT=/data/jingxiaoguan/contracts/pdf
MARKDOWN_ROOT=/data/jingxiaoguan/contracts/md-file
